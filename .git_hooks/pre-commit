#!/bin/bash

branch="$(git rev-parse --abbrev-ref HEAD)"

red="$(printf '\e[1;31m')"
bold="$(printf '\e[1m')"
norm="$(printf '\e[0m')"

if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
    cat << _EOF
${red}ERROR:${norm} You cannot commit directly to $branch branch

${bold}Neurospin-Brainomics Guidelines:${norm}

1. Always create a new branch for each feature, fix, or experiment – never work directly on main.

If you have stagged files and you want to commit them in your working branch do as follow:

1. git add <your-files>           # (opt) staged ALL modified files
2. git stash                      # put modified files in the stash
3. git checkout <your-branch>     # switch to your working branch
4. git stash pop                  # update the working branch
5. git commit -m "<your-msg>"     # commit to your working branch

_EOF
    exit 1
fi
